# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Generate two independent secrets, for example with: openssl rand -hex 32
CARD_HMAC_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
DEVICE_PAIRING_SECRET=REPLACE_WITH_A_DIFFERENT_64_HEX_SECRET

# Self-hosted face engine. Keep this endpoint private from the public internet.
COMPREFACE_URL=https://face.internal.example.edu.vn
COMPREFACE_API_KEY=YOUR_RECOGNITION_SERVICE_API_KEY
FACE_MATCH_THRESHOLD=0.88

# The web scanner simulator is intentionally unavailable in production.
ALLOW_WEB_SCANNER=false
